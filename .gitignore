# Python 产物
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# 测试与覆盖率产物
.coverage
.coverage.*
coverage.xml
coverage.json
.pytest_cache/
htmlcov/

# CI 与运行产物
# ⚠️ `_out/` 会匹配任意层级（根的 _out/ 和 examples/_out/ 都算）
_out/
*.log
# ★★ 例外：真机夹具里有 .log 文件（崩溃日志原文），**必须上传**！
#    否则依赖它们的测试会 FAIL。
#    实测踩坑：`*.log` 曾把 tests/fixtures/c4/cppcrash_real.log 一起排除掉，
#    而那是 3 个端到端测试的输入。例外规则必须写在排除规则**之后**才生效。
!tests/fixtures/**/*.log
!**/tests/fixtures/**/*.log

# 设备与工具
hdc.config.json
hdc.config.json.bak

# 编辑器 / 系统
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini

# ---------------------------------------------------------------
# ★ 以下内容**必须上传**，不要加进忽略列表：
#
#   tests/fixtures/         真机夹具（崩溃日志、控件树、截图）
#                           —— 部分测试直接依赖，缺了会 FAIL
#   tests/fixtures/c3/      跨形态真机夹具（Mate X7 桌面两态）
#   tests/fixtures/c4/      C4 信号采集夹具
#   ohauto/devices/form_profiles.json    77 条形态档案（代码依赖）
#   cases/*.yaml            用例
#   .gitcode/workflows/     AtomGit 流水线（目录名不能改）
#   .github/workflows/      GitHub Actions 备用
#   ci/                     CI 脚本（门禁本体）
# ---------------------------------------------------------------
